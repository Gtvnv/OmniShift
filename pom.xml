<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         http://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.3.2</version>
        <relativePath/>
    </parent>

    <groupId>br.com.github.gtvnv.omnishift</groupId>
    <artifactId>omnishift-parent</artifactId>
    <version>1.0.0</version>
    <packaging>pom</packaging>

    <modules>
        <module>omnishift-core</module>
        <module>omnishift-grpc-api</module>
        <module>omnishift-adapter-jackson-common</module>
        <module>omnishift-adapter-json</module>
        <module>omnishift-adapter-xml</module>
        <module>omnishift-adapter-yaml</module>
        <module>omnishift-runtime-spring</module>
    </modules>

    <properties>
        <java.version>21</java.version>
        <grpc.spring.boot.version>3.1.0.RELEASE</grpc.spring.boot.version>
        <grpc.version>1.68.1</grpc.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>io.grpc</groupId>
                <artifactId>grpc-bom</artifactId>
                <version>${grpc.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <dependency>
                <groupId>br.com.github.gtvnv.omnishift</groupId>
                <artifactId>omnishift-core</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>br.com.github.gtvnv.omnishift</groupId>
                <artifactId>omnishift-grpc-api</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>br.com.github.gtvnv.omnishift</groupId>
                <artifactId>omnishift-adapter-jackson-common</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>br.com.github.gtvnv.omnishift</groupId>
                <artifactId>omnishift-adapter-json</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>br.com.github.gtvnv.omnishift</groupId>
                <artifactId>omnishift-adapter-xml</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>br.com.github.gtvnv.omnishift</groupId>
                <artifactId>omnishift-adapter-yaml</artifactId>
                <version>${project.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

</project>
